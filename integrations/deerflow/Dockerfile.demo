FROM python:3.13-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 UV_HTTP_TIMEOUT=300 UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.9.26 -i https://pypi.tuna.tsinghua.edu.cn/simple
WORKDIR /app
COPY source.zip /tmp/source.zip
RUN python -c "import zipfile,pathlib,shutil; z=zipfile.ZipFile('/tmp/source.zip'); z.extractall('/tmp/source'); p=next(pathlib.Path('/tmp/source').iterdir()); shutil.copytree(p, '/app', dirs_exist_ok=True)"
WORKDIR /app/backend
RUN python -c "from pathlib import Path; p=Path('uv.lock'); p.write_text(p.read_text().replace('https://files.pythonhosted.org/packages/','https://pypi.tuna.tsinghua.edu.cn/packages/'))"
RUN uv sync --locked --no-dev --no-group extensions --python /usr/local/bin/python
COPY integration/tools.py /app/backend/vela_integration/client.py
COPY integration/registered_tools.py /app/backend/vela_integration/tools.py
RUN mkdir -p /app/skills/custom/vela-research /state && touch /app/backend/vela_integration/__init__.py && chown 10001:10001 /state
COPY integration/SKILL.md /app/skills/custom/vela-research/SKILL.md
COPY config.yaml /app/config.yaml
COPY research /research
RUN /app/backend/.venv/bin/python -m ensurepip && /app/backend/.venv/bin/python -m pip install --no-cache-dir matplotlib -i https://pypi.tuna.tsinghua.edu.cn/simple
RUN mkdir -p /research/runs && chown 10001:10001 /research/runs
ENV DEER_FLOW_PROJECT_ROOT=/app DEER_FLOW_CONFIG_PATH=/app/config.yaml DEER_FLOW_HOME=/state DEER_FLOW_AUTH_DISABLED=1 TIERLAB_SERVER_URL=http://host.docker.internal:8766 PYTHONIOENCODING=utf-8
USER 10001:10001
CMD ["/app/backend/.venv/bin/python", "-m", "uvicorn", "app.gateway.app:app", "--host", "0.0.0.0", "--port", "8001"]
